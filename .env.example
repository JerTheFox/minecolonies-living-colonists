# Copy this file to .env and fill in the values. .env is ignored by git.
# ./gradlew runClient and runServer pass these variables to the game.
# On a real server set them in the server's environment instead.

# API key for the OpenAI-compatible provider. The variable name can be
# changed with apiKeyEnv in config/livingcolonists-common.toml.
LIVINGCOLONISTS_API_KEY=
